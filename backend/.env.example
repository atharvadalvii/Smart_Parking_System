STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
GOOGLE_APPLICATION_CREDENTIALS=firebase_service_account.json
JWT_SECRET_KEY=your_jwt_secret_here
FLASK_ENV=development

# MQTT — Mosquitto broker (local RPi or HiveMQ cloud)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# InfluxDB — time-series metrics for Grafana dashboards
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your_org_here
INFLUXDB_BUCKET=parking
