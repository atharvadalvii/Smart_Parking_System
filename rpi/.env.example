# URL of the Flask backend — use the machine's LAN IP, not localhost,
# when the RPi and the server are on different devices.
BACKEND_URL=http://<flask-server-ip>:5001

MQTT_BROKER=<mqtt-broker-ip>
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Path to the GM65 QR scanner HID device (leave blank for auto-detect)
QR_DEVICE_PATH=
